# Environment variables for DATASYNC Market Tool
# Copy this file to .env and add your API keys

# Alpha Vantage API Key (Free tier: 5 API requests per minute, 500 requests per day)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# FRED API Key (Free - Federal Reserve Economic Data)
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_api_key_here

# News API Key (Free tier: 1000 requests/month)
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_api_key_here

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
